<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/seek_layout"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingTop="@dimen/dialog_padding_text"
	android:paddingBottom="@dimen/dialog_padding_text">

	<!-- The row grows with the switch instead of holding a fixed height: a Material switch is taller
	     than the text beside it, and a fixed 32dp row would clip its thumb. -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="32dp"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingLeft="@dimen/dialog_padding_view"
		android:paddingRight="@dimen/dialog_padding_view"
		android:layout_marginBottom="8dp">

		<TextView
			android:id="@+id/current_value"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textAppearance="?android:attr/textAppearanceListItem"
			android:paddingLeft="4dp"
			android:paddingRight="4dp" />

		<!-- A MaterialSwitch is added here in code, for the same reason as the Slider below. -->
		<FrameLayout
			android:id="@+id/switch_container"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="4dp"
			android:layout_marginRight="4dp" />

	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingLeft="@dimen/dialog_padding_text"
		android:paddingRight="@dimen/dialog_padding_text">

		<TextView
			android:id="@+id/min_value"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceListItemSmall" />

		<!-- A Material Slider is added here in code (ViewFactory.createSeekLayout); it must be built in
		     a Material3 context, so it cannot be inflated inline with this app-themed layout. -->
		<FrameLayout
			android:id="@+id/seek_bar_container"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1" />

		<TextView
			android:id="@+id/max_value"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceListItemSmall" />

	</LinearLayout>

</LinearLayout>
