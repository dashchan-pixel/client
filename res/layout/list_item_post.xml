<?xml version="1.0" encoding="utf-8"?>
<com.mishiranu.dashchan.widget.PostLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.mishiranu.dashchan.widget.PostBorderView
            android:id="@+id/border"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginLeft="2dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
                The header row, and with it the thumbnail of a post with a single attachment (the
                usual case — the attachments block below only takes over when Preferences
                .isAllAttachments is on). Its top padding is 16dp rather than the 10dp of its left
                padding because the 10dp is measured from the post border strip, which is itself
                6dp in from the post's edge: 6 + 10 puts the thumbnail 16dp from the left, and the
                16dp here gives it the same air above.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingTop="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="4dp">

                <!--
                    16dp of air between the thumbnail and the header text, the same gap the thread
                    list/card views keep between their thumbnail and subject. (The head below adds a
                    2dp inset of its own, so the text glyphs land ~18dp out — the 2dp is negligible.)
                -->
                <com.mishiranu.dashchan.widget.AttachmentView
                    android:id="@+id/thumbnail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="16dp"
                    android:layout_marginRight="16dp" />

                <com.mishiranu.dashchan.widget.LinebreakLayout
                    android:id="@+id/head"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:horizontalSpacing="4dp"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/index"
                        style="@style/Widget.HeaderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/name"
                        style="@style/Widget.HeaderText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/number"
                        style="@style/Widget.HeaderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/date"
                        style="@style/Widget.HeaderText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:singleLine="true"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/attachment_info"
                        style="@style/Widget.HeaderText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true" />

                </com.mishiranu.dashchan.widget.LinebreakLayout>

            </LinearLayout>

            <com.mishiranu.dashchan.widget.CarryLayout
                android:id="@+id/attachments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="6dp"
                android:paddingLeft="10dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp"
                android:paddingBottom="4dp"
                android:verticalSpacing="10dp">

            </com.mishiranu.dashchan.widget.CarryLayout>

            <com.mishiranu.dashchan.widget.LinebreakLayout
                android:id="@+id/voting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:horizontalSpacing="4dp"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="16dp"
                android:paddingBottom="4dp">

            </com.mishiranu.dashchan.widget.LinebreakLayout>

            <com.mishiranu.dashchan.widget.CommentTextView
                android:id="@+id/comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="16dp"
                android:paddingBottom="2dp"
                android:tag="theme.textColor=post"
                android:textColor="?attr/colorTextPost"
                android:textSize="@dimen/post_comment_text_size" />

            <View
                android:id="@+id/text_selection_padding"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:visibility="gone" />

            <!--
                Slot for chan.content.ChanPostDecorator. Sits between the comment and the bottom
                bar, and stays GONE unless the chan's decorator supplies a view for the bound post.
                Padded to line up with the comment text above it.
            -->
            <FrameLayout
                android:id="@+id/decorator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="16dp"
                android:visibility="gone" />

            <View
                android:id="@+id/text_bar_padding"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="16dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/bottom_bar_replies"
                    style="@style/Widget.PostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/bottom_bar_expand"
                    style="@style/Widget.PostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/expand" />

                <TextView
                    android:id="@+id/bottom_bar_open_thread"
                    style="@style/Widget.PostButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/open_thread" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.mishiranu.dashchan.widget.PostLinearLayout>
