<?xml version="1.0" encoding="utf-8"?>
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Android 16 Live Updates: lets download/posting ProgressStyle notifications promote to
	     the status bar chip and always-on display. -->
	<uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
	<!-- Extensions are discovered by scanning every installed package for a chan/lib extension
	     <uses-feature> declaration (ChanManager). A <queries> element can only match components by
	     intent, authority or package name, none of which identify an extension, so the broad
	     permission is the only way to enumerate them. -->
	<uses-permission
		android:name="android.permission.QUERY_ALL_PACKAGES"
		tools:ignore="QueryAllPackagesPermission" />
	<!-- Android 16 silently split-grants ACCESS_LOCAL_NETWORK from INTERNET ("allowed to keep app
	     working"). Declaring it explicitly revokes that auto-grant; the app never requests it, so it
	     stays denied instead of showing as an allowed "Nearby devices" permission. -->
	<uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

	<application
		android:name=".content.MainApplication"
		android:label="Dashchan"
		android:icon="@mipmap/ic_launcher"
		android:logo="@drawable/ic_logo"
		android:theme="@style/Theme.Launcher"
		android:enableOnBackInvokedCallback="true"
		android:allowBackup="true"
		android:fullBackupContent="true"
		android:usesCleartextTraffic="true"
		tools:ignore="GoogleAppIndexingWarning,UnusedAttribute">

		<activity
			android:name=".ui.MainActivity"
			android:launchMode="singleTask"
			android:exported="true">

			<intent-filter>
				<action android:name="chan.intent.action.HANDLE_URI" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:scheme="http" />
				<data android:scheme="https" />
			</intent-filter>

		</activity>

		<!-- Launcher entries live on aliases so the icon can be switched at runtime
		     (Preferences.AppIcon): exactly one alias is enabled at any time. -->
		<activity-alias
			android:name=".ui.MainActivityGradient"
			android:targetActivity=".ui.MainActivity"
			android:exported="true">

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>

		</activity-alias>

		<activity-alias
			android:name=".ui.MainActivityStriped"
			android:targetActivity=".ui.MainActivity"
			android:icon="@mipmap/ic_launcher_striped"
			android:enabled="false"
			android:exported="true">

			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>

		</activity-alias>

		<activity
			android:name=".content.PostingShareActivity"
			android:taskAffinity=".postingshare"
			android:launchMode="singleInstance"
			android:excludeFromRecents="true"
			android:exported="true"
			android:theme="@android:style/Theme.Translucent.NoTitleBar">

			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="*/*"/>
			</intent-filter>

			<intent-filter>
				<action android:name="android.intent.action.SEND_MULTIPLE" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="*/*"/>
			</intent-filter>

		</activity>

		<activity
			android:name=".ui.gallery.VideoPipActivity"
			android:exported="false"
			android:excludeFromRecents="true"
			android:supportsPictureInPicture="true"
			android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|uiMode|density"
			android:theme="@style/Theme.VideoPip" />

		<activity
			android:name=".content.UpdaterActivity"
			android:excludeFromRecents="true"
			android:exported="false"
			android:theme="@android:style/Theme.Panel" />

		<service
			android:name=".content.service.PostingService"
			android:exported="false"
			android:foregroundServiceType="dataSync" />

		<receiver
			android:name=".content.service.PostingService$Receiver"
			android:exported="false" />

		<service
			android:name=".content.service.DownloadService"
			android:exported="false"
			android:foregroundServiceType="dataSync" />

		<receiver
			android:name=".content.service.DownloadService$Receiver"
			android:exported="false" />

		<service
			android:name=".content.service.WatcherService"
			android:exported="false" />

		<receiver
			android:name=".content.ThreadContinuationResolver$Receiver"
			android:exported="false" />

		<service
			android:name=".content.service.AudioPlayerService"
			android:exported="false"
			android:foregroundServiceType="mediaPlayback" />

		<service
			android:name=".content.service.webview.WebViewService"
			android:exported="false"
			android:process=":webview" />

		<provider
			android:name=".content.FileProvider"
			android:authorities="com.mishiranu.providers.dashchan"
			android:exported="false"
			android:grantUriPermissions="true" />

	</application>

</manifest>
