/*
!/.gitignore
# Quality gate. This file is an allowlist (`/*` ignores everything), so each of these has
# to be named explicitly or the gate silently does not exist on a fresh clone or in CI.
!/.editorconfig
!/.github
!/detekt.yml
!/detekt-doublebang.yml
!/detekt-baseline.xml
!/AGENTS.md
!/CLAUDE.md
!/AndroidManifest.xml
!/build.gradle.kts
!/settings.gradle.kts
!/COPYING
!/gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/lang
!/metadata
!/proguard-rules.pro
!/README.md
!/res
!/scripts
!/src
!/update
